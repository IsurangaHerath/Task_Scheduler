@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom base styles */
@layer base {
  html {
    scroll-behavior: smooth;
  }
  
  body {
    @apply font-sans text-text-primary bg-background-main antialiased;
  }
  
  /* Dark mode base styles */
  html.dark body {
    @apply bg-[#0D1117] text-[#C9D1D9];
  }
  
  * {
    @apply border-border/20;
  }
  
  /* Dark mode borders */
  html.dark * {
    @apply border-[#30363D];
  }
}

/* Custom component styles */
@layer components {
  /* Button variants */
  .btn {
    @apply inline-flex items-center justify-center px-4 py-2 rounded-lg font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed;
  }
  
  .btn-primary {
    @apply btn bg-primary-dark text-white hover:bg-primary-hover focus:ring-primary shadow-soft hover:shadow-hover;
  }
  
  html.dark .btn-primary {
    @apply bg-[#1f6feb] hover:bg-[#388bfd];
  }
  
  .btn-secondary {
    @apply btn bg-primary-light text-text-primary hover:bg-primary focus:ring-primary;
  }
  
  html.dark .btn-secondary {
    @apply bg-[#30363D] text-[#C9D1D9] hover:bg-[#484F58];
  }
  
  .btn-outline {
    @apply btn border-2 border-primary-dark text-primary-dark hover:bg-primary-dark hover:text-white focus:ring-primary;
  }
  
  html.dark .btn-outline {
    @apply border-[#58A6FF] text-[#58A6FF] hover:bg-[#58A6FF] hover:text-[#0D1117];
  }
  
  .btn-ghost {
    @apply btn text-text-secondary hover:bg-primary-light/50 focus:ring-primary;
  }
  
  html.dark .btn-ghost {
    @apply text-[#8B949E] hover:bg-[#30363D];
  }
  
  .btn-danger {
    @apply btn bg-priority-high text-white hover:opacity-90 focus:ring-priority-high;
  }
  
  html.dark .btn-danger {
    @apply bg-[#da3633] hover:bg-[#f85149];
  }
  
  .btn-sm {
    @apply px-3 py-1.5 text-sm;
  }
  
  .btn-lg {
    @apply px-6 py-3 text-lg;
  }
  
  /* Card styles */
  .card {
    @apply bg-background-card rounded-xl shadow-card p-6 transition-all duration-200;
  }
  
  html.dark .card {
    @apply bg-[#161B22];
  }
  
  .card-hover {
    @apply card hover:shadow-hover hover:-translate-y-0.5 cursor-pointer;
  }
  
  /* Input styles */
  .input {
    @apply w-full px-4 py-2.5 rounded-lg border border-gray-200 bg-white text-text-primary placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200;
  }
  
  html.dark .input {
    @apply border-[#30363D] bg-[#0D1117] text-[#C9D1D9] placeholder:text-[#8B949E];
  }
  
  .input-error {
    @apply input border-priority-high focus:ring-priority-high;
  }
  
  html.dark .input-error {
    @apply border-[#f85149];
  }
  
  /* Label styles */
  .label {
    @apply block text-sm font-medium text-text-secondary mb-1.5;
  }
  
  html.dark .label {
    @apply text-[#8B949E];
  }
  
  /* Badge styles */
  .badge {
    @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
  }
  
  .badge-low {
    @apply badge bg-priority-low/30 text-text-primary;
  }
  
  html.dark .badge-low {
    @apply bg-[#0E5A2C]/40 text-[#3FB950];
  }
  
  .badge-medium {
    @apply badge bg-priority-medium/30 text-yellow-800;
  }
  
  html.dark .badge-medium {
    @apply bg-[#704D00]/40 text-[#D29922];
  }
  
  .badge-high {
    @apply badge bg-priority-high/30 text-red-800;
  }
  
  html.dark .badge-high {
    @apply bg-[#67060C]/40 text-[#F85149];
  }
  
  .badge-pending {
    @apply badge bg-blue-100 text-blue-800;
  }
  
  html.dark .badge-pending {
    @apply bg-[#0F3F5C]/40 text-[#58A6FF];
  }
  
  .badge-completed {
    @apply badge bg-status-success/30 text-text-primary;
  }
  
  html.dark .badge-completed {
    @apply bg-[#0E5A2C]/40 text-[#3FB950];
  }
  
  /* Sidebar styles */
  .sidebar-link {
    @apply flex items-center gap-3 px-4 py-3 rounded-lg text-text-secondary hover:bg-primary-light/50 hover:text-text-primary transition-all duration-200;
  }
  
  html.dark .sidebar-link {
    @apply text-[#8B949E] hover:bg-[#30363D] hover:text-[#C9D1D9];
  }
  
  .sidebar-link-active {
    @apply sidebar-link bg-primary-light text-text-primary font-medium;
  }
  
  html.dark .sidebar-link-active {
    @apply bg-[#238636] text-white;
  }
  
  /* Priority indicator */
  .priority-indicator {
    @apply w-3 h-3 rounded-full;
  }
  
  .priority-low {
    @apply priority-indicator bg-priority-low;
  }
  
  .priority-medium {
    @apply priority-indicator bg-priority-medium;
  }
  
  .priority-high {
    @apply priority-indicator bg-priority-high;
  }
}

/* Custom utilities */
@layer utilities {
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: theme('colors.primary.light') transparent;
  }
  
  html.dark .scrollbar-thin {
    scrollbar-color: #30363D transparent;
  }
  
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: theme('colors.primary.light');
    border-radius: 3px;
  }
  
  html.dark .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: #30363D;
  }
  
  .text-gradient {
    @apply bg-gradient-to-r from-primary-dark to-primary text-transparent bg-clip-text;
  }
}

/* Animation classes */
.animate-fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

.animate-slide-up {
  animation: slideUp 0.3s ease-out;
}

.animate-slide-down {
  animation: slideDown 0.3s ease-out;
}

.animate-scale-in {
  animation: scaleIn 0.2s ease-out;
}

/* Calendar custom styles */
.rbc-calendar {
  font-family: inherit;
}

html.dark .rbc-calendar {
  color: #C9D1D9;
}

.rbc-toolbar {
  @apply mb-4 flex-wrap gap-2;
}

.rbc-toolbar button {
  @apply bg-background-card border border-gray-200 text-text-secondary rounded-lg px-3 py-1.5 hover:bg-primary-light transition-colors;
}

html.dark .rbc-toolbar button {
  @apply bg-[#161B22] border-[#30363D] text-[#8B949E] hover:bg-[#30363D];
}

.rbc-toolbar button.rbc-active {
  @apply bg-primary-dark text-white border-primary-dark;
}

html.dark .rbc-toolbar button.rbc-active {
  @apply bg-[#1f6feb] text-white border-[#1f6feb];
}

.rbc-header {
  @apply py-2 font-medium text-text-secondary border-b border-gray-200;
}

html.dark .rbc-header {
  @apply text-[#8B949E] border-[#30363D];
}

.rbc-event {
  @apply rounded px-1.5 py-0.5 text-sm;
}

.rbc-today {
  @apply bg-primary-light/20;
}

html.dark .rbc-today {
  @apply bg-[#0E5A2C]/20;
}

/* Loading spinner */
.spinner {
  @apply w-6 h-6 border-2 border-primary-light border-t-primary-dark rounded-full animate-spin;
}

html.dark .spinner {
  @apply border-[#30363D] border-t-[#58A6FF];
}

.spinner-lg {
  @apply w-10 h-10 border-2;
}

/* Checkbox custom style */
.checkbox-custom {
  @apply w-5 h-5 rounded border-2 border-gray-300 appearance-none cursor-pointer checked:bg-primary-dark checked:border-primary-dark transition-all duration-200;
}

html.dark .checkbox-custom {
  @apply border-[#30363D] checked:bg-[#1f6feb] checked:border-[#1f6feb];
}

.checkbox-custom:checked {
  background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
}

/* Progress bar */
.progress-bar {
  @apply h-2 bg-gray-200 rounded-full overflow-hidden;
}

html.dark .progress-bar {
  @apply bg-[#30363D];
}
